# Copy to .env on the server and fill in. .env is listed in .gitignore. Never commit it.

# Required. Without it the server crashes on start.
OPENAI_API_KEY=your-openai-api-key

# Password for wireless firmware updates (16+ characters, or the /firmware routes switch themselves off).
# Generate one with: openssl rand -hex 24
FIRMWARE_TOKEN=change-me-to-a-long-random-string

# Optional. Defaults to 8080. Must match the port in SERVER in the ESP32's secrets.h.
# PORT=8080
